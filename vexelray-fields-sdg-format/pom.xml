<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vexelray.fields</groupId>
        <artifactId>vexelray-fields</artifactId>
        <version>0.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>vexelray-fields-sdg-format</artifactId>
    <packaging>jar</packaging>

    <name>vexelray-fields-sdg-format</name>
    <description>
        The SDG file, signed distance graphics: the drawing as records (pages, and layers of a stencil and a paint),
        and SdgFile to read and write it in its two forms, .sdg (XML, to read, write by hand and exchange) and .sdgb
        (one intrabuf payload, compiled from it, for the stack to load). Depends on the JDK and intrabuf-runtime,
        which depends on nothing, so a reader in the stack takes this alone.
    </description>

    <dependencies>
        <dependency>
            <groupId>sibarum.intrabuf</groupId>
            <artifactId>intrabuf-runtime</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>sibarum.intrabuf</groupId>
                            <artifactId>intrabuf-processor</artifactId>
                            <version>${intrabuf.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs combine.children="append">
                        <arg>-Aintrabuf.buildVersion=${project.version}</arg>
                        <!-- Release payloads whatever the project version, as vexelray-codec-asset: a snapshot
                             payload is refused by any build whose schema differs from its writer's, right for a
                             message between two builds and wrong for a file that outlives the build that wrote it.
                             So the schema only ever grows: fields at the end, @Field(since) and minor bumped. -->
                        <arg>-Aintrabuf.snapshot=false</arg>
                        <arg>-Aintrabuf.module=${project.artifactId}</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
